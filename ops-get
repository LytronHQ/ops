#!/usr/bin/env sh
#
# ops-get — fetch one script from a pinned release of this repo and verify it.
#
#   ops-get <script> <version> [dest]
#   ops-get harden.sh v1.0.0 /tmp/harden.sh
#
# There is no package manager worth the weight for a handful of shell scripts on
# a fresh Ubuntu box, so this is the smallest thing with the properties you
# actually want from one: a pinned version, a checksum, and no runtime to
# install first.
#
# It FAILS CLOSED. A missing release, a missing checksum, or a mismatch aborts
# without leaving the file behind — a provisioning run that stops loudly is worth
# a great deal more than one that quietly hardens a host with the wrong bytes.
#
# POSIX sh on purpose: it runs on the target, where bash is likely but not
# promised, and it is the first thing to run.
set -eu

REPO="${OPS_REPO:-LytronHQ/ops}"
SCRIPT="${1:?usage: ops-get <script> <version> [dest]}"
VERSION="${2:?usage: ops-get <script> <version> [dest]}"
DEST="${3:-./$SCRIPT}"
# Overridable for a mirror, an air-gapped copy, or a test that needs to serve a
# deliberately corrupted file and prove this refuses it.
BASE="${OPS_BASE_URL:-https://github.com/${REPO}/releases/download/${VERSION}}"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

fetch() { # url out
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else echo "ops-get: need curl or wget" >&2; exit 1; fi
}

fetch "${BASE}/${SCRIPT}"    "$tmp/$SCRIPT"   || { echo "ops-get: no $SCRIPT in $VERSION of $REPO" >&2; exit 1; }
fetch "${BASE}/SHA256SUMS"   "$tmp/SHA256SUMS" || { echo "ops-get: $VERSION has no SHA256SUMS — refusing to run unverified code" >&2; exit 1; }

want="$(awk -v f="$SCRIPT" '$2 == f || $2 == "*"f {print $1}' "$tmp/SHA256SUMS" | head -1)"
[ -n "$want" ] || { echo "ops-get: $SCRIPT is not listed in SHA256SUMS for $VERSION" >&2; exit 1; }

if command -v sha256sum >/dev/null 2>&1; then got="$(sha256sum "$tmp/$SCRIPT" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then got="$(shasum -a 256 "$tmp/$SCRIPT" | awk '{print $1}')"
else echo "ops-get: need sha256sum or shasum" >&2; exit 1; fi

[ "$want" = "$got" ] || { echo "ops-get: CHECKSUM MISMATCH for $SCRIPT@$VERSION" >&2
                          echo "  expected $want" >&2; echo "  got      $got" >&2; exit 1; }

mkdir -p "$(dirname "$DEST")"
cp "$tmp/$SCRIPT" "$DEST"
chmod +x "$DEST"
echo "$DEST"
