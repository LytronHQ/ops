#!/usr/bin/env sh
#
# ops-get — fetch one script from a pinned release of this repo and verify it.
#
# platforms: linux
#
#   ops-get <script> <version> [dest]      fetch, verify, write to dest (default ./<script>)
#   ops-get --list <version>               the scripts in that version, marking
#                                          any that do not run on this machine
#
#   ops-get server.sh v5.0.0 /tmp/server.sh
#
# A version is the release to fetch from, v5.0.0 (5.0.0 means the same). It is
# the script's version, not this file's: any ops-get fetches from any release.
#
# Options — every input is one; nothing is read from the environment:
#   --list <version>    list the scripts in a version, from its SHA256SUMS;
#                       those whose MANIFEST excludes this platform are marked
#   --repo <owner/name> whose releases to use (default LytronHQ/ops): a fork
#   --base-url <url>    the whole release URL, for a mirror, an air-gapped copy,
#                       or a test serving a deliberately corrupted file
#   -h, --help          this text
#
# There is no package manager worth the weight for a handful of shell scripts on
# a fresh Ubuntu box, so this is the smallest thing with the properties you
# actually want from one: a pinned version, a checksum, and no runtime to
# install first.
#
# It FAILS CLOSED. A missing release, a missing checksum, or a mismatch aborts
# without leaving the file behind — a provisioning run that stops loudly is worth
# a great deal more than one that quietly hardens a host with the wrong bytes.
#
# POSIX sh on purpose: it runs on the target, where bash is likely but not
# promised, and it is the first thing to run.
set -eu

die() { echo "ops-get: $*" >&2; exit 1; }
usage() { sed -n '3,/^set -eu/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

REPO="LytronHQ/ops" BASE="" LIST=""
SCRIPT="" VERSION="" DEST="" n=0
while [ $# -gt 0 ]; do
  case "$1" in
    --*=*) opt="${1%%=*}" val="${1#*=}"; shift; set -- "$opt" "$val" "$@" ;;
  esac
  case "$1" in
    --list|--repo|--base-url)
      [ $# -ge 2 ] && [ -n "$2" ] || die "$1 needs a value (try --help)" ;;
  esac
  case "$1" in
    --list)     LIST=1; VERSION="$2"; shift 2 ;;
    --repo)     REPO="$2"; shift 2 ;;
    --base-url) BASE="$2"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    -*)         die "unknown option '$1' (try --help)" ;;
    *)          n=$((n + 1))
                case "$n" in
                  1) SCRIPT="$1" ;; 2) VERSION="$1" ;; 3) DEST="$1" ;;
                  *) die "too many arguments (try --help)" ;;
                esac
                shift ;;
  esac
done

if [ -z "$LIST" ]; then
  # With nothing to do, show how to use it rather than an error.
  [ -n "$SCRIPT" ] || { usage >&2; exit 1; }
  [ -n "$VERSION" ] || die "which version? ops-get $SCRIPT <version>   (see: ops-get --list <version>)"
  case "$SCRIPT" in */*) die "'$SCRIPT': a script name, not a path — release assets are flat" ;; esac
fi
# Tags are v<number>; a bare number means that tag, not a missing version.
case "$VERSION" in [0-9]*) VERSION="v$VERSION" ;; esac
DEST="${DEST:-./$SCRIPT}"
BASE="${BASE:-https://github.com/${REPO}/releases/download/${VERSION}}"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

fetch() { # url out
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else die "need curl or wget"; fi
}

# SHA256SUMS first: it is both the proof and the table of contents. If it is
# not there, nothing else in the release can be trusted — and "no such script"
# would be the wrong thing to say when the whole version is missing. That is
# also what a release published minutes ago looks like, before GitHub serves it.
fetch "${BASE}/SHA256SUMS" "$tmp/SHA256SUMS" \
  || die "cannot get SHA256SUMS for $VERSION of $REPO. Either that version does not exist, it is still being published (a new release can take a few minutes to appear), or it has no checksums. Nothing was fetched."

# Every script the release vouches for — not the checksum file or the manifest.
scripts() { awk '{ f = $2; sub(/^\*/, "", f); if (f != "SHA256SUMS" && f != "MANIFEST") print f }' "$tmp/SHA256SUMS"; }
listed() { awk -v f="$1" '$2 == f || $2 == "*"f {print $1}' "$tmp/SHA256SUMS" | head -1; }

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  else die "need sha256sum or shasum"; fi
}

# fetch_verified NAME: download an asset and check it against SHA256SUMS, or die.
fetch_verified() {
  want="$(listed "$1")"
  fetch "${BASE}/$1" "$tmp/$1" \
    || die "$1 is listed in $VERSION's SHA256SUMS but could not be downloaded from ${BASE}/$1"
  got="$(sha256 "$tmp/$1")"
  [ "$want" = "$got" ] || { echo "ops-get: CHECKSUM MISMATCH for $1@$VERSION" >&2
                            echo "  expected $want" >&2; echo "  got      $got" >&2; exit 1; }
}

# The platform this runs on, in MANIFEST's words.
case "$(uname -s)" in
  Linux)                     PLATFORM=linux ;;
  Darwin)                    PLATFORM=macos ;;
  MINGW*|MSYS*|CYGWIN*)      PLATFORM=windows ;;
  *)                         PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')" ;;
esac

# MANIFEST says where each script runs. Releases before it have none, and then
# nothing is marked. When the release lists one it is verified like any asset:
# a list saying "runs here" is a claim, and an unverified claim is a way in.
HAS_MANIFEST=""
if [ -n "$(listed MANIFEST)" ]; then
  fetch_verified MANIFEST
  HAS_MANIFEST=1
fi
platforms_of() { [ -n "$HAS_MANIFEST" ] && awk -v f="$1" '$1 == f { $1 = ""; sub(/^ /, ""); print }' "$tmp/MANIFEST"; }
runs_here() { # script — true when there is no manifest entry to say otherwise
  p="$(platforms_of "$1" || true)"
  [ -z "$p" ] && return 0
  case " $p " in *" $PLATFORM "*) return 0 ;; esac
  return 1
}

if [ -n "$LIST" ]; then
  # Everything is listed; what does not run here says so, rather than being
  # hidden — hidden, a module looks like it does not exist.
  for f in $(scripts); do
    if runs_here "$f"; then echo "$f"
    else printf '%-16s unsupported on %s (runs on: %s)\n' "$f" "$PLATFORM" "$(platforms_of "$f")"; fi
  done
  exit 0
fi

[ -n "$(listed "$SCRIPT")" ] || die "$SCRIPT is not in $VERSION. It has: $(scripts | tr '\n' ' ')"
fetch_verified "$SCRIPT"
# Still fetched: it may be for another machine. But said, so nobody is surprised.
runs_here "$SCRIPT" \
  || echo "ops-get: note: $SCRIPT does not run on $PLATFORM (runs on: $(platforms_of "$SCRIPT")); fetched anyway" >&2

mkdir -p "$(dirname "$DEST")"
cp "$tmp/$SCRIPT" "$DEST"
chmod +x "$DEST"
echo "$DEST"
