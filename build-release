#!/usr/bin/env bash
#
# build-release — build a release's assets from this checkout: every script
# (.sh and .ps1) as a flat file, ops-get and ops-get.ps1, MANIFEST and
# SHA256SUMS. The release workflow runs it,
# and so does a person when Actions is unavailable, so there is one set of
# release rules rather than two copies that drift.
#
#   ./build-release [--out <dir>]      (default: dist)
#
# It refuses, building nothing, when:
#   - a script does not parse (PowerShell scripts are checked with PowerShell's
#     own parser, so this needs pwsh)
#   - two modules have a script with the same name (assets are flat)
#   - a script has no "# platforms:" line, or names an unknown platform
#
# MANIFEST has one line per asset: "<script> <platform>…", from each script's
# "# platforms:" header. ops-get --list reads it to mark what does not run on
# the machine asking. It is listed in SHA256SUMS like everything else, so the
# marks are as verified as the scripts.
set -euo pipefail
shopt -s inherit_errexit

die() { echo "build-release: $*" >&2; exit 1; }
cd "$(dirname "$0")"

OUT="dist"
while [ $# -gt 0 ]; do
  case "$1" in
    --out)     [ $# -ge 2 ] && [ -n "$2" ] || die "--out needs a value"; OUT="$2"; shift 2 ;;
    -h|--help) sed -n '3,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *)         die "unknown argument '$1'" ;;
  esac
done

# What `uname` can tell ops-get about the machine it runs on.
KNOWN_PLATFORMS="linux macos windows"

# The assets: ops-get for each shell, and every module script. Tests and their
# stubs are for working on the repo, never assets.
mapfile -t SCRIPTS < <(find . -mindepth 2 \( -name '*.sh' -o -name '*.ps1' \) -not -path './.git/*' \
  -not -path "./${OUT#./}/*" -not -path '*/tests/*' | sort)
SCRIPTS=(./ops-get ./ops-get.ps1 "${SCRIPTS[@]}")

PS1=()
for f in "${SCRIPTS[@]}"; do
  case "$f" in
    *.ps1)
      # Windows PowerShell 5.1 reads a file without a BOM as Windows-1252, where
      # the last byte of a UTF-8 em dash is a curly quote — a string delimiter
      # to PowerShell. So a PowerShell script is plain ASCII, or it does not ship.
      if LC_ALL=C grep -qn '[^[:print:][:space:]]' "$f"; then
        die "$f has non-ASCII characters, which Windows PowerShell 5.1 misreads: $(LC_ALL=C grep -n '[^[:print:][:space:]]' "$f" | head -1 | cut -c1-80)"
      fi
      PS1+=("$f") ;;
    *)     sh -n "$f" 2>/dev/null || bash -n "$f" || die "$f does not parse" ;;
  esac
done
if [ "${#PS1[@]}" -gt 0 ]; then
  command -v pwsh >/dev/null 2>&1 || die "needs pwsh to check the PowerShell scripts parse: ${PS1[*]}"
  # PowerShell's own parser, all files in one process, from a checker script
  # run with -File, so the paths arrive as arguments and nothing else. With
  # -Command they would not: extra arguments are appended to the command and
  # RUN — which executed ops-get.ps1 instead of parsing it.
  #
  # The real binary, found by asking pwsh itself: some installs (the snap)
  # wrap it in a launcher that aborts without a terminal.
  pwsh_bin="$(pwsh -NoProfile -NonInteractive -Command '(Get-Process -Id $PID).Path')"
  checker="$(mktemp --suffix=.ps1)"
  trap 'rm -f "$checker"' EXIT
  cat > "$checker" <<'PS'
foreach ($f in $args) {
  $errs = $null
  [void][System.Management.Automation.Language.Parser]::ParseFile((Resolve-Path -LiteralPath $f).Path, [ref]$null, [ref]$errs)
  if ($errs) { '{0}: {1} (line {2})' -f $f, $errs[0].Message, $errs[0].Extent.StartLineNumber }
}
PS
  bad="$("$pwsh_bin" -NoProfile -NonInteractive -File "$checker" "${PS1[@]}")"
  [ -z "$bad" ] || die "does not parse: $bad"
fi

dupes="$(for f in "${SCRIPTS[@]}"; do basename "$f"; done | sort | uniq -d)"
[ -z "$dupes" ] || die "two modules have a script with the same name, and assets are flat: $dupes"

manifest=""
for f in "${SCRIPTS[@]}"; do
  plats="$(sed -n 's/^# platforms:[[:space:]]*//p' "$f" | head -1)"
  [ -n "$plats" ] || die "$f has no '# platforms:' line — say where it runs"
  for p in $plats; do
    case " $KNOWN_PLATFORMS " in *" $p "*) ;; *) die "$f: unknown platform '$p' (known: $KNOWN_PLATFORMS)" ;; esac
  done
  manifest+="$(basename "$f") $plats"$'\n'
done

# It replaces --out wholesale, so it only ever replaces a previous build: an
# empty directory, or one holding a SHA256SUMS. `--out .` must not mean
# "delete the repository".
if [ -e "$OUT" ]; then
  [ -d "$OUT" ] || die "--out $OUT exists and is not a directory"
  [ -z "$(ls -A "$OUT")" ] || [ -f "$OUT/SHA256SUMS" ] \
    || die "--out $OUT is not empty and not a previous build; refusing to replace it"
  rm -rf "${OUT:?}"
fi
mkdir -p "$OUT"
for f in "${SCRIPTS[@]}"; do cp "$f" "$OUT/"; done
printf '%s' "$manifest" > "$OUT/MANIFEST"
(cd "$OUT" && sha256sum -- * > SHA256SUMS)
cat "$OUT/SHA256SUMS"
